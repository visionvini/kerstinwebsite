---
// Organisch geformter Bildrahmen statt Rechteck. Ohne `src` erscheint ein Platzhalter.
interface Props { src?: string; alt?: string; shape?: 1 | 2 | 3; ratio?: string; label?: string; class?: string }
const { src, alt = '', shape = 1, ratio = '4/5', label = 'Bild folgt', class: cls = '' } = Astro.props;
---
<div class={`blob blob-${shape} ${cls}`} style={`aspect-ratio:${ratio}`}>
  {src
    ? <img src={src} alt={alt} loading="lazy" class="h-full w-full object-cover" />
    : <div class="h-full w-full flex items-center justify-center text-sm text-ink/40">{label}</div>}
</div>
