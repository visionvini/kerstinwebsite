---
import '../styles/global.css';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  faq?: { q: string; a: string }[];
  isHome?: boolean;
}
const { title, description, noindex = false, faq, isHome = false } = Astro.props;
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '');
const canonical = `${site.url}${cleanPath}`;
const ogImage = new URL(site.ogImage, site.url).href;

// Strukturierte Daten kommen komplett aus der zentralen Konfiguration
const business = {
  '@context': 'https://schema.org',
  '@type': ['ProfessionalService', 'LocalBusiness'],
  name: site.brand,
  url: site.url,
  telephone: site.telefon,
  email: site.email,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.strasse,
    postalCode: site.plz,
    addressLocality: site.ort,
    addressCountry: 'DE',
  },
  founder: { '@type': 'Person', name: site.name, jobTitle: 'Gestalttherapeutin, Paartherapeutin' },
  sameAs: [site.instagram, 'https://www.therapie.de/profil/bonke/'],
};
const faqLd = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(business)} />}
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </head>
  <body>
    <a href="#inhalt" class="sr-only focus:not-sr-only focus:absolute focus:p-3 focus:bg-white">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt"><slot /></main>
    <Footer bg={isHome ? 'soft' : 'page'} />
  </body>
</html>
